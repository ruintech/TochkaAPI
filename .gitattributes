* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf

# Файлы генерируются из swagger.json: в ревью их сворачивают, смотреть нужно диффы
# swagger.json и классов сервисов в src/main/java/com/tochka/api/api.
swagger.json linguist-generated=true
src/main/java/com/tochka/api/model/** linguist-generated=true

# Сертификаты и фикстуры подписей не трогаем: важна байтовая целостность.
*.pem -text
*.jwt -text
